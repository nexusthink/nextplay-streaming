# ==============================================================================
# NEXTPLAY STREAMING - CONFIGURAÇÕES DE AMBIENTE NA VPS
# ==============================================================================

# Porta externa na VPS (8090 por padrão para não conflitar com o GoRango na 8080)
APP_PORT=8090

# Nome do Aplicativo
VITE_APP_NAME=NextPlay

# URL pública da API/VPS para o APK (Opcional, ex: http://SEU_IP_DA_VPS:8090)
VITE_API_URL=

# Segredo para assinatura dos tokens de sessão
NEXTPLAY_TOKEN_SECRET=nextplay-vps-secret-key-2026

